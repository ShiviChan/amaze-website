# Copy to scripts/aws.env (gitignored) and fill in credentials.
export AWS_REGION=ap-south-1
export AWS_DEFAULT_REGION=ap-south-1

# S3 + CloudFront (same region stack as amazesolutions.in)
export S3_BUCKET=asnmcare-website-prod
export CLOUDFRONT_DISTRIBUTION_ID=

# Route 53 hosted zone for asnmcare.com
export HOSTED_ZONE_ID=Z094069137F2HE9WPRBTY

# CloudFront OAC + ACM (cert must stay us-east-1 — AWS rule for CloudFront SSL)
export OAC_ID=E178FZM7DD1UU3
export ACM_CERT_REGION=us-east-1
export CERT_ARN=arn:aws:acm:us-east-1:113204171133:certificate/6ddd7b7c-b3e6-47e1-9a75-b072952bbd4e
